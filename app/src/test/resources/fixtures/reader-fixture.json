        "has_children": false,
        "in_trash": false,
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "This single sentence deliberately runs well past any plausible chunk threshold so that a splitter which only understands sentence boundaries has no choice but to fall through to its word boundary rule and break the text somewhere in the middle of a clause rather than at a punctuation mark, which is precisely the fallback path that must be exercised before the threshold constant can be chosen with any confidence at all.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "This single sentence deliberately runs well past any plausible chunk threshold so that a splitter which only understands sentence boundaries has no choice but to fall through to its word boundary rule and break the text somewhere in the middle of a clause rather than at a punctuation mark, which is precisely the fallback path that must be exercised before the threshold constant can be chosen with any confidence at all.",
              "href": null
            }
          ],
          "icon": null,
          "color": "default"
        }
      },
