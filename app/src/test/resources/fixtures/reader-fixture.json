        "last_edited_by": {
          "object": "user",
          "id": "3dec9345-e10a-8165-bb85-0027caf1119d"
        },
        "has_children": false,
        "in_trash": false,
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "no sentence ending punctuation appears anywhere in this block just commas and semicolons and the occasional dash but never a full stop so a splitter has to fall back again first to a word boundary and if even that is not enough to a hard split at the character limit which is the last resort the fallback chain defines and which should essentially never be reached by ordinary prose",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "no sentence ending punctuation appears anywhere in this block just commas and semicolons and the occasional dash but never a full stop so a splitter has to fall back again first to a word boundary and if even that is not enough to a hard split at the character limit which is the last resort the fallback chain defines and which should essentially never be reached by ordinary prose",
              "href": null
            }
          ],
          "icon": null,
          "color": "default"
        }
